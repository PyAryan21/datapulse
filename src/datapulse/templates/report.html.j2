<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>datapulse report — {{ report.metadata.source }}</title>
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js" charset="utf-8"></script>
<style>
  :root {
    --bg: #ffffff; --fg: #1a1a2e; --muted: #6b7280;
    --accent: #2563eb; --card: #f9fafb; --border: #e5e7eb;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Segoe UI", system-ui, sans-serif; background: var(--bg); color: var(--fg); }
  .header { background: linear-gradient(135deg, #1e3a8a, #2563eb); color: #fff; padding: 28px 40px; }
  .header h1 { margin: 0 0 6px; font-size: 26px; }
  .header .meta { opacity: .85; font-size: 14px; }
  .stats { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 14px; }
  .stat { background: rgba(255,255,255,.14); border-radius: 8px; padding: 8px 14px; min-width: 110px; }
  .stat b { display: block; font-size: 20px; }
  .stat span { font-size: 12px; opacity: .85; }
  .container { padding: 24px 40px; max-width: 1400px; margin: 0 auto; }
  section { margin-bottom: 32px; }
  h2 { border-bottom: 2px solid var(--border); padding-bottom: 8px; font-size: 20px; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  th, td { border: 1px solid var(--border); padding: 7px 10px; text-align: left; }
  th { background: var(--card); }
  tr:nth-child(even) { background: var(--card); }
  .chart { margin: 14px 0; border: 1px solid var(--border); border-radius: 10px; padding: 8px; background: #fff; }
  .badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .badge.ok { background: #d1fae5; color: #065f46; }
  .badge.warn { background: #fef3c7; color: #92400e; }
  .badge.err { background: #fee2e2; color: #991b1b; }
  code { background: var(--card); padding: 2px 6px; border-radius: 4px; font-size: 13px; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 900px) { .grid2 { grid-template-columns: 1fr; } .container { padding: 16px; } }
</style>
</head>
<body>
<div class="header">
  <h1>⚡ datapulse report</h1>
  <div class="meta">
    Source: <code style="background:rgba(255,255,255,.2); color:#fff">{{ report.metadata.source }}</code>
    &nbsp;·&nbsp; v{{ report.metadata.datapulse_version }} &nbsp;·&nbsp; {{ report.metadata.created_at[:19].replace("T"," ") }} UTC
    &nbsp;·&nbsp; {{ report.metadata.duration_s }}s
  </div>
  {% if profile %}
  <div class="stats">
    <div class="stat"><b>{{ profile.rows }}</b><span>rows</span></div>
    <div class="stat"><b>{{ profile.columns }}</b><span>columns</span></div>
    <div class="stat"><b>{{ profile.memory_mb }} MB</b><span>memory</span></div>
    <div class="stat"><b>{{ profile.missing_summary|length }}</b><span>cols w/ nulls</span></div>
    <div class="stat"><b>{{ quality.duplicate_rows }}</b><span>duplicates</span></div>
  </div>
  {% endif %}
</div>

<div class="container">
  {% if profile %}
  <section>
    <h2>📋 Dataset Overview</h2>
    {% if charts.get("dtype_pie") %}<div class="chart" id="dtype_pie"></div>{% endif %}
    <table>
      <thead><tr><th>Column</th><th>Dtype</th><th>Null %</th><th>Cardinality</th><th>Min</th><th>Mean</th><th>Max</th></tr></thead>
      <tbody>
      {% for c in profile.column_profiles %}
        <tr>
          <td><code>{{ c.name }}</code></td>
          <td>{{ c.dtype }}</td>
          <td>{{ "%.2f"|format(c.null_pct) }}</td>
          <td>{{ c.cardinality }}</td>
          <td>{{ c.stats.get("min", "-") }}</td>
          <td>{{ "%.3g"|format(c.stats.get("mean", 0)) if c.stats.get("mean") is not none else "-" }}</td>
          <td>{{ c.stats.get("max", "-") }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  {% if charts.get("corr_heatmap") %}
  <section>
    <h2>🔗 Correlations</h2>
    <div class="chart" id="corr_heatmap"></div>
  </section>
  {% endif %}
  {% endif %}

  {% if automl %}
  <section>
    <h2>🤖 AutoML</h2>
    <table>
      <thead><tr><th>Model</th><th>{{ automl.metric }} (CV mean)</th><th>± std</th></tr></thead>
      <tbody>
      {% for m in automl.leaderboard %}
        <tr><td>{{ m.name }}</td><td>{{ "%.4f"|format(m.cv_mean) }}</td><td>{{ "%.4f"|format(m.cv_std) }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% for name, fig in charts.items() %}
    {% if name not in ["dtype_pie", "corr_heatmap"] %}
    <section>
      <h2>📊 {{ name.replace("_", " ")|title }}</h2>
      <div class="chart" id="{{ name }}"></div>
    </section>
    {% endif %}
  {% endfor %}
</div>

<script>
  const charts = {{ chart_json | safe }};
  for (const [id, fig] of Object.entries(charts)) {
    const el = document.getElementById(id);
    if (el) Plotly.newPlot(el, fig.data, fig.layout, {responsive: true});
  }
</script>
</body>
</html>
